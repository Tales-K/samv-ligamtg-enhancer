{
  "manifest_version": 3,
  "name": "SAMV LigaMtg Enhancer",
  "version": "1.3.0",
  "description": "Aprimorador não oficial do LigaMagic: preços em reais no Archidekt, Moxfield e Scryfall e melhorias de navegação.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "*://*.ligamagic.com.br/*",
    "*://*.archidekt.com/*",
    "*://*.moxfield.com/*",
    "*://*.scryfall.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAMV LigaMtg Enhancer",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ligamagic.com.br/*"],
      "js": ["lista-favorites-guard.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.ligamagic.com.br/*"],
      "css": ["content.css"],
      "js": ["content-utils.js", "detailed-format.js", "nav-menu.js", "scraper-deck.js", "deck-view.js", "deck-copy-button.js", "lista-defaults.js", "store-search-override.js", "lista-copy-button.js", "analise-economia.js", "carrinho-copy-button.js", "card-hover-links.js", "scraper-card.js", "content.js"]
    },
    {
      "matches": ["*://*.archidekt.com/*"],
      "js": ["overlay-utils.js", "overlay-archidekt.js"]
    },
    {
      "matches": ["*://*.moxfield.com/*"],
      "js": ["overlay-utils.js", "overlay-moxfield.js"]
    },
    {
      "matches": ["*://*.scryfall.com/*"],
      "js": ["overlay-utils.js", "overlay-scryfall.js", "overlay-scryfall-tags.js", "overlay-scryfall-filter.js"]
    }
  ]
}
